<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Header: Đồng hồ + Device ID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 - Thứ Tư"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="#1E293B"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="ID: tv_redmi_01"
                android:textColor="#38BDF8"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Widget Card Giá Xăng & Giá Vàng -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:weightSum="2">

                <!-- Cột Giá Xăng -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛽ GIÁ XĂNG DẦU HÔM NAY"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFuelPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Đang tải..."
                        android:textColor="#F1F5F9"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Cột Giá Vàng -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪙 GIÁ VÀNG SJC HÔM NAY"
                        android:textColor="#FACC15"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoldPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Đang tải..."
                        android:textColor="#F1F5F9"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvPriceUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thanh công cụ quản lý App -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ỨNG DỤNG CỦA TÔI"
                android:textColor="#CBD5E1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleHidden"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#334155"
                android:focusable="true"
                android:text="Xem App đã ẩn"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnToggleEdit"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#0284C7"
                android:focusable="true"
                android:text="Sắp xếp / Ẩn App"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Danh sách App hiển thị 1 dòng ngang -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

    </LinearLayout>

    <!-- Lớp phủ Khóa TV từ xa -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 TV ĐANG BỊ KHÓA TỪ XA"
            android:textColor="#EF4444"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vui lòng mở khóa trên ứng dụng điện thoại để tiếp tục sử dụng."
            android:textColor="#E2E8F0"
            android:textSize="18sp" />
    </LinearLayout>

</FrameLayout>
